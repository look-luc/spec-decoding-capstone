# ==========================================
# 1. TREE NODE DATA STRUCTURE & HELPERS
# ==========================================

CREATE_NODE(INDEX, PARENT, TOKEN_ID, HIDDEN_STATE, DEPTH, SCORE)
    NODE = NEW STRUCTURE
    NODE.INDEX = INDEX
    NODE.PARENT = PARENT
    NODE.TOKEN_ID = TOKEN_ID
    NODE.HIDDEN_STATE = HIDDEN_STATE
    NODE.DEPTH = DEPTH
    NODE.SCORE = SCORE
    NODE.CHILDREN = EMPTY_LIST()
    IF PARENT IS NOT NULL
        APPEND NODE TO PARENT.CHILDREN
    RETURN NODE


GET_NODE_DEPTH(NODE)
    DEPTH = 0
    CURR = NODE
    WHILE CURR.PARENT IS NOT NULL
        DEPTH = DEPTH + 1
        CURR = CURR.PARENT
    RETURN DEPTH


GET_ANCESTOR_TOKENS(NODE)
    TOKENS = EMPTY_LIST()
    CURR = NODE
    WHILE CURR IS NOT NULL
        PREPEND CURR.TOKEN_ID TO TOKENS
        CURR = CURR.PARENT
    RETURN TOKENS


EXTRACT_TOKEN_IDS(TREE_NODES)
    RETURN TENSOR([NODE.TOKEN_ID FOR NODE IN TREE_NODES])


EXTRACT_ALL_LEAF_PATHS(TREE_NODES)
    LEAF_PATHS = EMPTY_LIST()
    FOR NODE IN TREE_NODES
        IF LENGTH(NODE.CHILDREN) == 0
            PATH = EMPTY_LIST()
            CURR = NODE
            WHILE CURR IS NOT NULL
                PREPEND CURR TO PATH
                CURR = CURR.PARENT
            APPEND PATH TO LEAF_PATHS
    RETURN LEAF_PATHS


# ==========================================
# 2. TOKEN & SEQUENCING UTILITIES
# ==========================================

GET_STOP_TOKEN_IDS(TOKENIZER, EOS_TOKEN_ID)
    STOP_IDS = EMPTY_SET()

    IF EOS_TOKEN_ID IS NOT NULL
        ADD EOS_TOKEN_ID TO STOP_IDS
    IF HAS_ATTRIBUTE(TOKENIZER, "eos_token_id") AND TOKENIZER.EOS_TOKEN_ID IS NOT NULL
        ADD TOKENIZER.EOS_TOKEN_ID TO STOP_IDS

    STOP_TOKENS = ["<|im_end|>", "<|endoftext|>", "<|eot_id|>", "<|end_of_text|>", "</s>", "<end_of_turn>", "<eos>", "[/INST]"]
    FOR TOKEN IN STOP_TOKENS
        IDS = TOKENIZER.ENCODE(TOKEN, ADD_SPECIAL_TOKENS=FALSE)
        IF LENGTH(IDS) == 1
            ADD IDS[0] TO STOP_IDS

    RETURN STOP_IDS


SLIDING_WINDOW(TOKENS, WINDOW)
    IF WINDOW <= 0 OR LENGTH(TOKENS) <= WINDOW
        RETURN TOKENS
    RETURN TOKENS[-WINDOW:]


ANY_IN_SET(TOKENS, TARGET_SET)
    FOR TOKEN IN TOKENS
        IF TOKEN IN TARGET_SET
            RETURN TRUE
    RETURN FALSE


# ==========================================
# 3. SAMPLING & LOGIT PROCESSING
# ==========================================

APPLY_TOP_K(LOGITS, K)
    IF K < 1
        RAISE ERROR "top_k must be >= 1"
    IF K >= VOCAB_SIZE(LOGITS)
        RETURN LOGITS

    TOP_VALUES = TOP_K_VALUES(LOGITS, K)
    KTH_VALUE = TOP_VALUES[..., -1]

    FOR EACH POSITION IN LOGITS
        IF LOGITS[POSITION] < KTH_VALUE
            LOGITS[POSITION] = -INFINITY

    RETURN LOGITS


APPLY_TOP_P(LOGITS, P)
    IF P < 0.0 OR P > 1.0
        RAISE ERROR "top_p must be between 0.0 and 1.0"
    IF P >= 1.0
        RETURN LOGITS

    SORTED_LOGITS, SORTED_INDICES = SORT_DESCENDING(LOGITS)
    CUMULATIVE_PROBS = CUMSUM(SOFTMAX(SORTED_LOGITS))

    MASK_TO_REMOVE = CUMULATIVE_PROBS > P
    SHIFT_RIGHT(MASK_TO_REMOVE, BY=1, KEEP_FIRST=FALSE)

    LOGITS[SORTED_INDICES[MASK_TO_REMOVE]] = -INFINITY
    RETURN LOGITS


FILTER_LOGPROBS(LOGPROBS, TOP_K, TOP_P)
    FILTERED = LOGPROBS
    IF TOP_K > 0
        FILTERED = APPLY_TOP_K(FILTERED, K=TOP_K)
    IF 0.0 < TOP_P < 1.0
        FILTERED = APPLY_TOP_P(FILTERED, P=TOP_P)
    IF TOP_K > 0 OR 0.0 < TOP_P < 1.0
        FILTERED = LOG_SOFTMAX(FILTERED)
    RETURN FILTERED


SAMPLE(LOGPROBS, MODE)
    IF MODE == "greedy"
        RETURN ARGMAX(LOGPROBS)
    ELSE
        RETURN CATEGORICAL_SAMPLE(LOGITS=LOGPROBS)


TOP_K_SAMPLING(LOGPROBS, K)
    SORTED_LOGPROBS, SORTED_INDICES = SORT_DESCENDING(LOGPROBS)
    TOP_SCORES = SORTED_LOGPROBS[:K]
    TOP_TOKEN_IDS = SORTED_INDICES[:K]
    RETURN TOP_SCORES, TOP_TOKEN_IDS


APPLY_REPETITION_PENALTY(LOGITS, CONTEXT_IDS, PENALTY)
    IF PENALTY == 1.0 OR LENGTH(CONTEXT_IDS) == 0
        RETURN LOGITS

    WINDOW_COUNTS = COUNT_FREQUENCIES(CONTEXT_IDS)
    FOR TOKEN_ID, COUNT IN WINDOW_COUNTS
        FACTOR = PENALTY ^ COUNT
        IF LOGITS[TOKEN_ID] > 0
            LOGITS[TOKEN_ID] = LOGITS[TOKEN_ID] / FACTOR
        ELSE
            LOGITS[TOKEN_ID] = LOGITS[TOKEN_ID] * FACTOR

    RETURN LOGITS


APPLY_REPETITION_PENALTY_BATCHED(LOGITS, GENERATED_TOKENS, CONFIRMED_LEN, PENALTY, WINDOW)
    IF PENALTY == 1.0
        RETURN LOGITS

    BATCH_SIZE, SEQ_LEN, VOCAB_SIZE = SIZE(LOGITS)
    FOR B FROM 0 TO BATCH_SIZE - 1
        FOR J FROM 0 TO SEQ_LEN - 1
            CONTEXT = GENERATED_TOKENS[B, MAX(0, CONFIRMED_LEN + J - WINDOW) : CONFIRMED_LEN + J]
            LOGITS[B, J] = APPLY_REPETITION_PENALTY(LOGITS[B, J], CONTEXT, PENALTY)

    RETURN LOGITS


# ==========================================
# 4. KV CACHE MANAGEMENT
# ==========================================

GET_KV_CACHE_LENGTH(PAST_KEY_VALUES)
    IF PAST_KEY_VALUES IS NULL
        RETURN 0
    IF HAS_ATTRIBUTE(PAST_KEY_VALUES, "get_seq_length")
        RETURN PAST_KEY_VALUES.GET_SEQ_LENGTH()
    IF PAST_KEY_VALUES IS TUPLE AND LENGTH(PAST_KEY_VALUES) > 0
        IF RANK(PAST_KEY_VALUES[0][0]) == 4
            RETURN SIZE(PAST_KEY_VALUES[0][0], DIM=2)
        ELSE
            RETURN SIZE(PAST_KEY_VALUES[0][0], DIM=-1)
    RETURN 0


CROP_KV_CACHE(PAST_KEY_VALUES, NEW_LENGTH)
    IF PAST_KEY_VALUES IS NULL
        RETURN NULL

    IF HAS_ATTRIBUTE(PAST_KEY_VALUES, "crop")
        PAST_KEY_VALUES.CROP(NEW_LENGTH)
        RETURN PAST_KEY_VALUES
    ELSE
        NEW_PAST = EMPTY_LIST()
        FOR LAYER_PAST IN PAST_KEY_VALUES
            IF LAYER_PAST IS TENSOR
                APPEND LAYER_PAST[..., :NEW_LENGTH] TO NEW_PAST
            ELSE IF LENGTH(LAYER_PAST) == 2
                KEY_STATE, VALUE_STATE = LAYER_PAST
                K_CROPPED = KEY_STATE[..., :NEW_LENGTH, :]
                V_CROPPED = VALUE_STATE[..., :NEW_LENGTH, :]
                APPEND (K_CROPPED, V_CROPPED) TO NEW_PAST
        RETURN TUPLE(NEW_PAST)


CROP_AND_ALIGN_EAGLE_KV_CACHE(KV_CACHE, ACCEPTED_PATH_NODES, BASE_SEQ_LEN)
    IF KV_CACHE IS NULL
        RETURN NULL

    ACCEPTED_INDICES = [NODE.INDEX FOR NODE IN ACCEPTED_PATH_NODES]
    UPDATED_KV_CACHE = EMPTY_LIST()

    FOR LAYER_KV IN KV_CACHE
        IF LAYER_KV IS TENSOR
            BASE_STATE = LAYER_KV[..., :BASE_SEQ_LEN]
            PATH_STATE = LAYER_KV[..., BASE_SEQ_LEN + ACCEPTED_INDICES]
            NEW_STATE = CONCAT(BASE_STATE, PATH_STATE, DIM=-1)
            APPEND NEW_STATE TO UPDATED_KV_CACHE
        ELSE IF LENGTH(LAYER_KV) == 2
            KEY_STATES, VALUE_STATES = LAYER_KV

            BASE_KEYS = KEY_STATES[..., :BASE_SEQ_LEN, :]
            BASE_VALUES = VALUE_STATES[..., :BASE_SEQ_LEN, :]

            PATH_KEYS = KEY_STATES[..., BASE_SEQ_LEN + ACCEPTED_INDICES, :]
            PATH_VALUES = VALUE_STATES[..., BASE_SEQ_LEN + ACCEPTED_INDICES, :]

            NEW_KEYS = CONCAT(BASE_KEYS, PATH_KEYS, DIM=-2)
            NEW_VALUES = CONCAT(BASE_VALUES, PATH_VALUES, DIM=-2)

            APPEND (NEW_KEYS, NEW_VALUES) TO UPDATED_KV_CACHE

    RETURN TUPLE(UPDATED_KV_CACHE)


# ==========================================
# 5. EAGLE TREE ATTENTION & EXPANSION
# ==========================================

BUILD_EAGLE_TREE_ATTENTION(TREE_NODES, BASE_SEQ_LEN)
    NUM_NODES = LENGTH(TREE_NODES)
    TOTAL_LEN = BASE_SEQ_LEN + NUM_NODES
    ATTN_MASK = MATRIX(NUM_NODES, TOTAL_LEN, FILL=-INFINITY)
    POSITION_IDS = ARRAY(NUM_NODES)

    FOR I FROM 0 TO NUM_NODES - 1
        NODE_I = TREE_NODES[I]
        POSITION_IDS[I] = BASE_SEQ_LEN + NODE_I.DEPTH

        # Prefix sequence is fully visible
        FOR J FROM 0 TO BASE_SEQ_LEN - 1
            ATTN_MASK[I, J] = 0.0

        # Causal ancestry mask inside the draft tree
        CUR_ANCESTOR = NODE_I
        WHILE CUR_ANCESTOR IS NOT NULL
            ATTN_MASK[I, BASE_SEQ_LEN + CUR_ANCESTOR.INDEX] = 0.0
            CUR_ANCESTOR = CUR_ANCESTOR.PARENT

    RETURN ATTN_MASK, POSITION_IDS


EAGLE_DRAFT_TREE_EXPANSION(
    EAGLE_MODULE,
    ROOT_HIDDEN,
    ROOT_TOKEN_ID,
    TREE_CHOICES,
    TOP_K,
    TOP_P,
    REPETITION_PENALTY,
    REPETITION_PENALTY_WINDOW,
    GENERATED_TOKENS,
    CUR_GEN_IDX,
    MODE
)
    TREE_NODES = EMPTY_LIST()

    ROOT_NODE = CREATE_NODE(
        INDEX=0,
        PARENT=NULL,
        TOKEN_ID=ROOT_TOKEN_ID,
        HIDDEN_STATE=ROOT_HIDDEN,
        DEPTH=0,
        SCORE=1.0
    )
    APPEND ROOT_NODE TO TREE_NODES
    ACTIVE_PARENTS = [ROOT_NODE]

    FOR DEPTH FROM 1 TO LENGTH(TREE_CHOICES)
        BRANCH_FACTOR = TREE_CHOICES[DEPTH - 1]
        NEXT_PARENTS = EMPTY_LIST()

        FOR PARENT IN ACTIVE_PARENTS
            TOKEN_EMB = EAGLE_MODULE.GET_EMBEDDING(PARENT.TOKEN_ID)
            FUSED_FEAT = CONCAT(TOKEN_EMB, PARENT.HIDDEN_STATE, DIM=-1)
            NEXT_HIDDEN = EAGLE_MODULE.DECODER_LAYER(FUSED_FEAT)
            DRAFT_RAW_LOGITS = EAGLE_MODULE.LM_HEAD(NEXT_HIDDEN)

            PATH_TOKENS = GET_ANCESTOR_TOKENS(PARENT)
            FULL_CONTEXT = CONCAT(GENERATED_TOKENS[0, :CUR_GEN_IDX], PATH_TOKENS)
            PENALTY_CONTEXT = SLIDING_WINDOW(FULL_CONTEXT, WINDOW=REPETITION_PENALTY_WINDOW)

            PENALIZED_LOGITS = APPLY_REPETITION_PENALTY(DRAFT_RAW_LOGITS, PENALTY_CONTEXT, REPETITION_PENALTY)
            DRAFT_LOGPROBS = FILTER_LOGPROBS(LOG_SOFTMAX(PENALIZED_LOGITS), TOP_K, TOP_P)

            TOP_SCORES, TOP_TOKEN_IDS = TOP_K_SAMPLING(DRAFT_LOGPROBS, K=BRANCH_FACTOR)

            FOR K_IDX FROM 0 TO BRANCH_FACTOR - 1
                CHILD_NODE = CREATE_NODE(
                    INDEX=LENGTH(TREE_NODES),
                    PARENT=PARENT,
                    TOKEN_ID=TOP_TOKEN_IDS[K_IDX],
                    HIDDEN_STATE=NEXT_HIDDEN,
                    DEPTH=DEPTH,
                    SCORE=PARENT.SCORE * EXP(TOP_SCORES[K_IDX])
                )
                APPEND CHILD_NODE TO TREE_NODES
                APPEND CHILD_NODE TO NEXT_PARENTS

        ACTIVE_PARENTS = NEXT_PARENTS

    RETURN TREE_NODES


# ==========================================
# 6. MAIN SPECULATIVE DECODING ALGORITHM
# ==========================================

SPECULATIVE_DECODE_EAGLE(
    TARGET_MODEL,
    EAGLE_MODULE,
    TOKENIZER,
    INPUT_IDS,
    MODE="greedy",
    MAX_NEW_TOKENS=128,
    TREE_CHOICES=[1, 4, 2, 2],
    TOP_K=0,
    TOP_P=0.0,
    REPETITION_PENALTY=1.1,
    REPETITION_PENALTY_WINDOW=16,
    EOS_TOKEN_ID=NULL,
    DEVICE=NULL,
    TRACK_ITERATIONS=FALSE
)
    BS = SIZE(INPUT_IDS, 0)
    ASSERT BS == 1, "Speculative decoding only supports batch_size=1"

    IF DEVICE IS NULL
        DEVICE = GET_MODEL_DEVICE(TARGET_MODEL)

    STOP_TOKEN_IDS = GET_STOP_TOKEN_IDS(TOKENIZER, EOS_TOKEN_ID)
    INPUT_IDS = TO_DEVICE(INPUT_IDS, DEVICE)

    GENERATED_TOKENS = CONCAT(INPUT_IDS, ZEROS(BS, MAX_NEW_TOKENS, DEVICE=DEVICE))
    PROMPT_LEN = SIZE(INPUT_IDS, -1)
    CUR_GEN_IDX = PROMPT_LEN

    TOTAL_DRAFT_TOKENS = 0
    TOTAL_MATCHED_TOKENS = 0
    NUM_ITERATIONS = 0
    START_TIME = GET_TIME()

    # Initial Prefill Pass on Target Model
    TARGET_OUT = TARGET_MODEL(INPUT_IDS, USE_CACHE=TRUE, OUTPUT_HIDDEN_STATES=TRUE)
    TARGET_KV_CACHE = TARGET_OUT.PAST_KEY_VALUES

    LAST_HIDDEN = TARGET_OUT.LAST_HIDDEN_STATE[:, -1, :]
    FIRST_LOGITS = APPLY_REPETITION_PENALTY(
        TARGET_OUT.LOGITS[:, -1, :],
        GENERATED_TOKENS[0, MAX(0, CUR_GEN_IDX - REPETITION_PENALTY_WINDOW) : CUR_GEN_IDX],
        REPETITION_PENALTY
    )
    FIRST_LOGPROBS = FILTER_LOGPROBS(LOG_SOFTMAX(FIRST_LOGITS), TOP_K, TOP_P)
    FIRST_TOKEN = SAMPLE(FIRST_LOGPROBS, MODE)

    GENERATED_TOKENS[:, CUR_GEN_IDX] = FIRST_TOKEN
    CUR_GEN_IDX = CUR_GEN_IDX + 1

    # Main Speculative Verification Loop
    WHILE CUR_GEN_IDX < SIZE(GENERATED_TOKENS, -1)
        NUM_ITERATIONS = NUM_ITERATIONS + 1
        BASE_SEQ_LEN = CUR_GEN_IDX
        CURRENT_TOKEN = GENERATED_TOKENS[:, CUR_GEN_IDX - 1]

        # Draft Phase: Parallel Tree Expansion via EAGLE
        TREE_NODES = EAGLE_DRAFT_TREE_EXPANSION(
            EAGLE_MODULE=EAGLE_MODULE,
            ROOT_HIDDEN=LAST_HIDDEN,
            ROOT_TOKEN_ID=CURRENT_TOKEN,
            TREE_CHOICES=TREE_CHOICES,
            TOP_K=TOP_K,
            TOP_P=TOP_P,
            REPETITION_PENALTY=REPETITION_PENALTY,
            REPETITION_PENALTY_WINDOW=REPETITION_PENALTY_WINDOW,
            GENERATED_TOKENS=GENERATED_TOKENS,
            CUR_GEN_IDX=CUR_GEN_IDX,
            MODE=MODE
        )

        FLATTENED_TOKENS = EXTRACT_TOKEN_IDS(TREE_NODES)
        TREE_ATTN_MASK, TREE_POSITION_IDS = BUILD_EAGLE_TREE_ATTENTION(TREE_NODES, BASE_SEQ_LEN)

        # Verification Phase: Parallel Target Pass
        TARGET_OUT = TARGET_MODEL(
            INPUT_IDS=FLATTENED_TOKENS,
            ATTENTION_MASK=TREE_ATTN_MASK,
            POSITION_IDS=TREE_POSITION_IDS,
            PAST_KEY_VALUES=TARGET_KV_CACHE,
            USE_CACHE=TRUE,
            OUTPUT_HIDDEN_STATES=TRUE
        )

        TARGET_RAW_LOGITS = TARGET_OUT.LOGITS
        VERIFIER_HIDDENS = TARGET_OUT.LAST_HIDDEN_STATE

        PENALIZED_TARGET_LOGITS = APPLY_REPETITION_PENALTY_BATCHED(
            LOGITS=TARGET_RAW_LOGITS,
            GENERATED_TOKENS=CONCAT(GENERATED_TOKENS[:, :CUR_GEN_IDX], FLATTENED_TOKENS),
            CONFIRMED_LEN=CUR_GEN_IDX,
            PENALTY=REPETITION_PENALTY,
            WINDOW=REPETITION_PENALTY_WINDOW
        )
        TARGET_LOGPROBS = FILTER_LOGPROBS(LOG_SOFTMAX(PENALIZED_TARGET_LOGITS), TOP_K, TOP_P)

        # Path Evaluation Phase: Find Deepest Accepted Path
        CANDIDATE_PATHS = EXTRACT_ALL_LEAF_PATHS(TREE_NODES)
        BEST_PATH = EMPTY_LIST()
        BEST_ACCEPT_COUNT = -1
        BONUS_TOKEN = NULL
        NEW_LAST_HIDDEN = NULL

        FOR PATH IN CANDIDATE_PATHS
            ACCEPTED_IN_PATH = EMPTY_LIST()
            FOR STEP FROM 0 TO LENGTH(PATH) - 2
                PARENT_NODE = PATH[STEP]
                CHILD_NODE = PATH[STEP + 1]

                PRED_TOKEN = SAMPLE(TARGET_LOGPROBS[:, PARENT_NODE.INDEX, :], MODE)

                IF PRED_TOKEN == CHILD_NODE.TOKEN_ID
                    APPEND CHILD_NODE TO ACCEPTED_IN_PATH
                ELSE
                    BREAK

            IF LENGTH(ACCEPTED_IN_PATH) > BEST_ACCEPT_COUNT
                BEST_ACCEPT_COUNT = LENGTH(ACCEPTED_IN_PATH)
                BEST_PATH = ACCEPTED_IN_PATH

                LAST_ACCEPTED_NODE = IF LENGTH(ACCEPTED_IN_PATH) > 0 THEN LAST(ACCEPTED_IN_PATH) ELSE PATH[0]
                BONUS_TOKEN = SAMPLE(TARGET_LOGPROBS[:, LAST_ACCEPTED_NODE.INDEX, :], MODE)
                NEW_LAST_HIDDEN = VERIFIER_HIDDENS[:, LAST_ACCEPTED_NODE.INDEX, :]

        # Commit Phase: Append Accepted Tokens & Bonus Token
        ACCEPTED_TOKENS = [NODE.TOKEN_ID FOR NODE IN BEST_PATH]
        TOKENS_TO_ADD = CONCAT(ACCEPTED_TOKENS, [BONUS_TOKEN])

        NEW_GEN_IDX = CUR_GEN_IDX + LENGTH(TOKENS_TO_ADD)
        GENERATED_TOKENS[:, CUR_GEN_IDX : NEW_GEN_IDX] = TOKENS_TO_ADD
        CUR_GEN_IDX = NEW_GEN_IDX

        TOTAL_MATCHED_TOKENS = TOTAL_MATCHED_TOKENS + BEST_ACCEPT_COUNT
        TOTAL_DRAFT_TOKENS = TOTAL_DRAFT_TOKENS + LENGTH(TREE_NODES) - 1

        # Cache Update & State Reset
        TARGET_KV_CACHE = CROP_AND_ALIGN_EAGLE_KV_CACHE(
            KV_CACHE=TARGET_OUT.PAST_KEY_VALUES,
            ACCEPTED_PATH_NODES=BEST_PATH,
            BASE_SEQ_LEN=BASE_SEQ_LEN
        )
        LAST_HIDDEN = NEW_LAST_HIDDEN

        IF ANY_IN_SET(TOKENS_TO_ADD, STOP_TOKEN_IDS)
            GENERATED_TOKENS = GENERATED_TOKENS[:, :CUR_GEN_IDX]
            BREAK

    TOTAL_TIME = GET_TIME() - START_TIME
    ACCEPTANCE_RATE = IF TOTAL_DRAFT_TOKENS > 0 THEN TOTAL_MATCHED_TOKENS / TOTAL_DRAFT_TOKENS ELSE 0.0
    TOTAL_GENERATED_TOKENS = CUR_GEN_IDX - PROMPT_LEN

    METRICS = {
        "time": TOTAL_TIME,
        "generated_tokens": TOTAL_GENERATED_TOKENS,
        "draft_tokens": TOTAL_DRAFT_TOKENS,
        "matched_tokens": TOTAL_MATCHED_TOKENS,
        "acceptance_rate": ACCEPTANCE_RATE,
        "num_iterations": NUM_ITERATIONS,
        "toks_per_sec": IF TOTAL_TIME > 0 THEN TOTAL_GENERATED_TOKENS / TOTAL_TIME ELSE 0
    }

    RETURN GENERATED_TOKENS, METRICS
